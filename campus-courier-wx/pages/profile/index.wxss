.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 32px;
}

.profile-card {
  background: #fff;
  padding: 24px;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  position: relative;
  margin-right: 16px;
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: 50%;
}

.edit-hint {
  position: absolute;
  bottom: -20px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 12px;
  color: #999;
  white-space: nowrap;
}

.info {
  flex: 1;
}

.nickname {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 12px;
}

.stats {
  display: flex;
  gap: 24px;
}

.stat-item {
  text-align: center;
}

.stat-item .value {
  display: block;
  font-size: 16px;
  font-weight: bold;
  color: #07c160;
}

.stat-item .label {
  font-size: 12px;
  color: #999;
}

.button-wrapper {
  margin: 24px 16px;
}

.uploader-container {
  padding: 24px;
  display: flex;
  justify-content: center;
} 