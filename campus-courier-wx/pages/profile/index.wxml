<view class="container">
  <!-- 个人信息卡片 -->
  <view class="profile-card">
    <view class="avatar-wrapper" bindtap="onChangeAvatar">
      <image class="avatar" src="{{ courier.avatar || '/assets/default-avatar.png' }}" mode="aspectFill"/>
      <view class="edit-hint">点击修改头像</view>
    </view>
    <view class="info">
      <view class="nickname">{{ courier.nickname || '未设置昵称' }}</view>
      <view class="stats">
        <view class="stat-item">
          <text class="value">{{ courier.completedOrders || 0 }}</text>
          <text class="label">完成订单</text>
        </view>
        <view class="stat-item">
          <text class="value">{{ courier.rating || '暂无' }}</text>
          <text class="label">综合评分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 个人信息表单 -->
  <van-cell-group title="基本信息">
    <van-field
      label="昵称"
      value="{{ courier.nickname }}"
      placeholder="请输入昵称"
      bind:change="onNicknameChange"
    />
    <van-field
      label="联系方式"
      value="{{ courier.contact }}"
      placeholder="请输入联系方式"
      bind:change="onContactChange"
    />
    <van-field
      label="个人简介"
      value="{{ courier.introduction }}"
      placeholder="请输入个人简介"
      type="textarea"
      autosize
      bind:change="onIntroductionChange"
    />
  </van-cell-group>

  <!-- 保存按钮 -->
  <view class="button-wrapper">
    <van-button type="primary" block bind:click="onSave">保存修改</van-button>
  </view>

  <!-- 头像上传弹窗 -->
  <van-dialog
    use-slot
    title="修改头像"
    show="{{ showUploader }}"
    bind:close="onCloseUploader"
    confirmButtonText="确定"
    bind:confirm="onConfirmAvatar"
  >
    <view class="uploader-container">
      <van-uploader
        file-list="{{ fileList }}"
        bind:after-read="afterRead"
        bind:delete="onDeleteFile"
        max-count="1"
      />
    </view>
  </van-dialog>
</view> 