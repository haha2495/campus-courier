.container {
  min-height: 100vh;
  background: #f7f8fa;
}

.order-list {
  height: calc(100vh - 44px);
}

.rating {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #666;
  margin-bottom: 4px;
}

.comment {
  font-size: 12px;
  color: #666;
}

.loading,
.no-more {
  text-align: center;
  padding: 16px;
  color: #999;
  font-size: 14px;
} 