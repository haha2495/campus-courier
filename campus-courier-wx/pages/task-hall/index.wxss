.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.search-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}

.task-list {
  margin-top: 108px;
  flex: 1;
  overflow-y: auto;
}

.task-detail {
  padding: 16px;
}

.detail-item {
  margin-bottom: 12px;
}

.detail-item .label {
  color: #666;
  margin-right: 8px;
} 