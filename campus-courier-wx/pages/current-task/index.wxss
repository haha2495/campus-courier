.container {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 16px;
}

.progress-section {
  margin-top: 16px;
  background: #fff;
  border-radius: 8px;
  padding: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 16px;
}

.message-section {
  margin-top: 16px;
  background: #fff;
  border-radius: 8px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  height: 400px;
}

.message-list {
  flex: 1;
  overflow-y: auto;
}

.message-item {
  margin-bottom: 12px;
}

.message-item.self {
  text-align: right;
}

.message-content {
  display: inline-block;
  max-width: 70%;
  padding: 8px 12px;
  background: #f2f2f2;
  border-radius: 4px;
}

.message-item.self .message-content {
  background: #07c160;
  color: #fff;
}

.message-time {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.message-input {
  margin-top: 16px;
  border-top: 1px solid #eee;
  padding-top: 16px;
} 