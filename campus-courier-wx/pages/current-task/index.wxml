<view class="container">
  <!-- 任务卡片 -->
  <van-card
    wx:if="{{ task }}"
    price="{{ task.reward }}"
    title="{{ task.title }}"
    desc="{{ task.description }}"
    thumb="{{ task.thumb }}"
  >
    <view slot="footer">
      <van-button size="small" bind:click="onViewMessages">查看留言</van-button>
    </view>
  </van-card>

  <!-- 任务进度 -->
  <view class="progress-section">
    <view class="section-title">任务进度</view>
    <van-steps
      steps="{{ steps }}"
      active="{{ active }}"
      direction="vertical"
    />
  </view>

  <!-- 留言区域 -->
  <view class="message-section" wx:if="{{ showMessages }}">
    <view class="section-title">留言记录</view>
    <scroll-view 
      scroll-y 
      class="message-list"
      bindscrolltolower="onLoadMoreMessages"
    >
      <view 
        class="message-item {{ item.senderId === currentUserId ? 'self' : '' }}"
        wx:for="{{ messages }}"
        wx:key="id"
      >
        <view class="message-content">{{ item.content }}</view>
        <view class="message-time">{{ item.createTime }}</view>
      </view>
    </scroll-view>

    <!-- 发送留言 -->
    <view class="message-input">
      <van-field
        value="{{ messageContent }}"
        placeholder="请输入留言内容"
        border="{{ false }}"
        bind:change="onMessageChange"
      >
        <van-button 
          slot="button" 
          size="small" 
          type="primary"
          bind:click="onSendMessage"
        >发送</van-button>
      </van-field>
    </view>
  </view>
</view> 